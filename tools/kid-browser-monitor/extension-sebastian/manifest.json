{
  "manifest_version": 3,
  "name": "Chrome Performance Helper",
  "version": "1.0.0",
  "description": "Helps optimize browser performance metrics.",
  "permissions": ["history", "alarms", "storage"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "minimum_chrome_version": "116",
  "icons": {
    "128": "icon128.png"
  }
}
